# Copy to .env (git ignores .env) and fill in. chmod 600 .env, the oracle refuses a
# file other users can read. Only SILVERLAKE_ORACLE_* names are read from it.
#
# A test profile on the host you capture from. Never a real account.
SILVERLAKE_ORACLE_USER=
SILVERLAKE_ORACLE_PASS=
# Hosts the oracle may connect to besides loopback.
SILVERLAKE_ORACLE_HOSTS=pub400.com
